#ifndef AMC_GENERATED_CONFIG_H
#define AMC_GENERATED_CONFIG_H

// Build-tree location of the CodeIn templates. The runtime also searches
// install-relative locations so an installed provider keeps working.
#define AMC_CODEIN_DIR "@AMC_CODEIN_DIR@"
#define AMC_CODEIN_INSTALL_SUBDIR "@CMAKE_INSTALL_DATADIR@/AMC/CodeIn"

#endif   // AMC_GENERATED_CONFIG_H
